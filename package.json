{
  "name": "@webergency-utils/aggregator",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "description": "A highly efficient TypeScript batching utility that groups, deduplicates, and chunks concurrent asynchronous requests within the same execution tick.",
  "author": "radixxko",
  "license": "MIT",
  "main": "dist/aggregator.cjs",
  "module": "dist/aggregator.js",
  "types": "dist/aggregator.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/aggregator.d.ts",
        "default": "./dist/aggregator.js"
      },
      "require": {
        "types": "./dist/aggregator.d.cts",
        "default": "./dist/aggregator.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "npm run build && vitest run",
    "fuzz": "npm run build && jazzer fuzz_aggregator.cjs",
    "coverage": "npm run build && vitest run --coverage",
    "clean": "rm -rf ./dist",
    "reset": "npm run clean && rm -rf node_modules package-lock.json && npm i",
    "build": "npm run clean && tsup",
    "commit": "node -e \"const version = require('./package.json').version.trim(); require('child_process').execSync('git add . && git commit -m \\\"Version ' + version + '\\\"');\"",
    "version": "npm run build && npm publish --access public && npm run commit && git push"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webergency-utils/aggregator.git"
  },
  "bugs": {
    "url": "https://github.com/webergency-utils/aggregator/issues"
  },
  "homepage": "https://github.com/webergency-utils/aggregator#readme",
  "dependencies": {
    "@webergency-utils/object-hash": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "tsup": "^9.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "nanoid": "^3.3.18"
  }
}
